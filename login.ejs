<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - GreenEdge AI</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="login-page">

    <div class="login-card">

        <a href="/" class="back-btn">←</a>

        <div class="login-heading">
            <h1>Welcome Back!</h1>
            <p>Log in to continue</p>
        </div>

        <div class="login-image">
            <img src="/images/login-person.png" alt="Login">
        </div>

        <form action="/home" method="GET">

            <div class="input-box">
                <span class="input-icon">✉</span>
                <input
                    type="text"
                    name="email"
                    placeholder="Email / Phone"
                    required
                >
            </div>

            <div class="input-box">
                <span class="input-icon">🔒</span>

                <input
                    type="password"
                    name="password"
                    id="password"
                    placeholder="Password"
                    required
                >

                <button type="button" class="eye-btn" onclick="showPassword()">
                    👁
                </button>
            </div>

            <div class="forgot-password">
                <a href="#">Forgot Password?</a>
            </div>

            <button type="submit" class="login-btn">
                LOGIN
            </button>
            <!-- ADD THIS BIOMETRIC BUTTON -->
            <button type="button" id="biometricBtn" class="login-btn" style="background: #111; margin-top: 10px;" onclick="triggerBiometricLogin()">
                <i class="fa-solid fa-fingerprint"></i> Login with Touch ID
            </button>
            <!-- END NEW BUTTON --> 

        </form>

        <div class="register-text">
            Don't have an account?
            <a href="/register">Register</a>
        </div>
        <a href="/home"></a>
    </div>
</div>

<script src="/js/login.js"></script>
<!-- ADD THESE TWO LINES: -->
<script src="/js/common.js"></script>
<script src="/js/voice_assistant_core.js"></script>

</body>
</html> 